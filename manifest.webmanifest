{
  "name": "BreVista Studio: Espresso Dial-In",
  "short_name": "Dial-In",
  "description": "Taste-first espresso dial-in. One change per shot, tuned to your grinder.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#F5F5F5",
